# Copy to .env.local for local dev. On Vercel, set these in Project Settings > Environment Variables.

# Supabase (local values come from `pnpm db:start`; hosted ones from Project Settings > API Keys).
# Without these, live sync falls back to tabs of the same browser only.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Signs login cookies. Required in production; generate with: openssl rand -hex 32
SESSION_SECRET=
